{
  "name": "stock-basic",
  "version": "1.0.0",
  "description": "股票基础数据获取 Skill，提供个股信息、历史行情、市场全景等基础数据查询",
  "author": "stock-analyse",
  "license": "MIT",
  "runtime": "uv",
  "entry": "scripts/main.py",
  "environment": {
    "PYTHONPATH": "/mnt/github/stockAnalyse/",
    "VIRTUAL_ENV": "/mnt/github/stockAnalyse/.venv"
  },
  "inputs": {
    "action": {
      "type": "string",
      "required": true,
      "enum": ["info", "history", "spot"],
      "description": "操作类型：info(基本信息), history(历史行情), spot(实时行情)"
    },
    "market": {
      "type": "string",
      "required": true,
      "enum": ["SH", "SZ", "H", "usa"],
      "description": "市场代码"
    },
    "symbol": {
      "type": "string",
      "required": false,
      "description": "股票代码，action=spot 时可不传"
    },
    "start_date": {
      "type": "string",
      "required": false,
      "description": "开始日期，格式 YYYYMMDD"
    },
    "end_date": {
      "type": "string",
      "required": false,
      "description": "结束日期，格式 YYYYMMDD"
    }
  },
  "outputs": {
    "success": {
      "type": "boolean",
      "description": "操作是否成功"
    },
    "data": {
      "type": "object",
      "description": "返回数据"
    },
    "message": {
      "type": "string",
      "description": "提示信息"
    }
  }
}
