{
  "name": "stock-valuation",
  "version": "1.0.0",
  "description": "价值投资分析 Skill，支持 DCF 现金流折价、相对估值比较和公允价值区间测算",
  "author": "stock-analyse",
  "license": "MIT",
  "runtime": "uv",
  "entry": "scripts/main.py",
  "environment": {
    "PYTHONPATH": "/mnt/github/stockAnalyse/",
    "VIRTUAL_ENV": "/mnt/github/stockAnalyse/.venv"
  },
  "inputs": {
    "action": {
      "type": "string",
      "required": true,
      "enum": ["dcf", "price_range", "compare"],
      "description": "操作类型"
    },
    "market": {
      "type": "string",
      "required": true,
      "enum": ["SH", "SZ", "H", "usa"],
      "description": "市场代码"
    },
    "symbol": {
      "type": "string",
      "required": true,
      "description": "股票代码"
    },
    "discount_rate": {
      "type": "number",
      "required": false,
      "default": 0.1,
      "description": "折现率参数，DCF 模型使用"
    }
  },
  "outputs": {
    "success": {
      "type": "boolean",
      "description": "操作是否成功"
    },
    "data": {
      "type": "object",
      "description": "返回数据"
    },
    "message": {
      "type": "string",
      "description": "提示信息"
    }
  }
}
