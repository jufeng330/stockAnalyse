{
  "name": "stock-financial",
  "version": "1.0.0",
  "description": "股票财务分析 Skill，提供财务报表、财务指标和估值计算功能",
  "author": "stock-analyse",
  "license": "MIT",
  "runtime": "uv",
  "entry": "scripts/main.py",
  "environment": {
    "PYTHONPATH": "/mnt/github/stockAnalyse/",
    "VIRTUAL_ENV": "/mnt/github/stockAnalyse/.venv"
  },
  "inputs": {
    "action": {
      "type": "string",
      "required": true,
      "enum": ["report", "indicators", "valuation"],
      "description": "操作类型：report(三大报表), indicators(财务指标), valuation(DCF/DISC 估值)"
    },
    "market": {
      "type": "string",
      "required": true,
      "enum": ["SH", "SZ", "H", "usa"],
      "description": "市场代码"
    },
    "symbol": {
      "type": "string",
      "required": true,
      "description": "股票代码，必填参数"
    },
    "years": {
      "type": "integer",
      "required": false,
      "default": 5,
      "description": "获取历史年份数"
    }
  },
  "outputs": {
    "success": {
      "type": "boolean",
      "description": "操作是否成功"
    },
    "data": {
      "type": "object",
      "description": "返回数据"
    },
    "message": {
      "type": "string",
      "description": "提示信息"
    }
  }
}
