{
  "name": "stock-concept",
  "version": "1.0.0",
  "description": "股票概念板块 Skill，提供行业/概念板块查询和成分股分析",
  "author": "stock-analyse",
  "license": "MIT",
  "runtime": "uv",
  "entry": "scripts/main.py",
  "environment": {
    "PYTHONPATH": "/mnt/github/stockAnalyse/",
    "VIRTUAL_ENV": "/mnt/github/stockAnalyse/.venv"
  },
  "inputs": {
    "action": {
      "type": "string",
      "required": true,
      "enum": ["list_concept", "list_industry", "components", "by_stock", "detail"],
      "description": "操作类型"
    },
    "market": {
      "type": "string",
      "required": true,
      "enum": ["SH", "SZ", "H", "usa", "zq"],
      "description": "市场代码"
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "板块名称"
    },
    "symbol": {
      "type": "string",
      "required": false,
      "description": "股票代码"
    }
  },
  "outputs": {
    "success": {
      "type": "boolean"
    },
    "data": {
      "type": "object"
    },
    "message": {
      "type": "string"
    }
  }
}
